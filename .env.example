# VITE_GEMINI_API_KEY is gone on purpose. Vite inlines every VITE_ var into
# the public bundle and Gemini keys cannot be domain-restricted, so it was
# readable by anyone. Gemini now goes through the gemini edge function; set
# GEMINI_API_KEY as a function secret instead:
#   supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
# VITE_GOOGLE_PLACES_API_KEY is gone on purpose. Vite inlines every VITE_
# var into the public bundle, and this key was unrestricted -- anyone could
# read it off the site and spend the budget. Every Places/Geocoding call now
# goes through the places edge function, which holds the key, requires a
# session, caps each user and caches results for everybody:
#   supabase secrets set GOOGLE_PLACES_API_KEY=... --project-ref <ref>
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OPENAI_API_KEY is NOT exposed to the client. Set it as a Supabase Edge
# Function secret instead:
#   supabase secrets set OPENAI_API_KEY=sk-proj-...

# Web Push. Generate a keypair, put the public half here and in
# netlify.toml, and set the private half as an edge function secret:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=...
VITE_VAPID_PUBLIC_KEY=
